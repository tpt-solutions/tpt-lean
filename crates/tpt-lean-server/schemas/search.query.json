{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search.query",
  "permission": "read",
  "params": {
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": { "type": "string" },
      "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
    }
  },
  "result": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "kind", "source", "line", "score"],
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string" },
            "source": { "type": "string" },
            "line": { "type": "integer" },
            "score": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
