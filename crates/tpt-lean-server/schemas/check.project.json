{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "check.project",
  "permission": "build",
  "params": {
    "type": "object",
    "properties": {
      "timeout": { "type": "integer", "minimum": 1, "maximum": 3600, "description": "Seconds allowed for lake build." }
    }
  },
  "result": {
    "type": "object",
    "required": ["schema_version", "ok", "project", "toolchain", "build", "total_ms", "diagnostics", "failures", "cache"],
    "properties": {
      "schema_version": { "type": "integer" },
      "ok": { "type": "boolean" },
      "project": { "type": "string" },
      "toolchain": { "type": "object" },
      "build": {
        "type": "object",
        "required": ["status", "exit_code", "duration_ms"],
        "properties": {
          "status": { "type": "string", "enum": ["passed", "failed", "timeout", "not_run"] },
          "exit_code": { "type": ["integer", "null"] },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      },
      "total_ms": { "type": "integer", "minimum": 0 },
      "diagnostics": { "type": "array" },
      "failures": { "type": "array" },
      "cache": { "type": "object" }
    }
  }
}
