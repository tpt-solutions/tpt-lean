{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build.cancel",
  "permission": "build",
  "params": {
    "type": "object",
    "properties": {
      "run_id": { "type": "string", "description": "A running build id; omit to cancel the newest running build." }
    }
  },
  "result": {
    "type": "object",
    "required": ["run_id", "cancelled"],
    "properties": {
      "run_id": { "type": ["string", "null"] },
      "cancelled": { "type": "boolean" },
      "status": { "type": "string" }
    }
  }
}
