{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "imports.unused",
  "permission": "read",
  "params": {
    "type": "object",
    "required": ["path"],
    "properties": {
      "path": { "type": "string", "description": "Project-relative or absolute path to a .lean file inside the root." }
    }
  },
  "result": {
    "type": "object",
    "required": ["findings"],
    "properties": {
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["code", "severity", "file", "line", "message"],
          "properties": {
            "code": { "type": "string" },
            "severity": { "type": "string", "enum": ["warning", "info", "error"] },
            "file": { "type": "string" },
            "line": { "type": "integer", "minimum": 0 },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
