{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "format.text",
  "permission": "read",
  "params": {
    "type": "object",
    "required": ["text"],
    "properties": {
      "text": { "type": "string" }
    }
  },
  "result": {
    "type": "object",
    "required": ["formatted", "changed"],
    "properties": {
      "formatted": { "type": "string" },
      "changed": { "type": "boolean" }
    }
  }
}
